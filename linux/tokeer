#!/usr/bin/env bash
#
# tokeer <CODE> - redeem a Tokeer code into the game's Proton prefix and launch.
#
# One command per activation. Setup (install_linux.sh <APPID>) must have run once
# for the game first - it sets the launch option so the launched game loads the
# Denuvo hook. This just fetches the tickets for <CODE>, writes them into the
# prefix, and starts the game through Steam.
#
set -euo pipefail

TDIR="${TOKEER_HOME:-$HOME/.tokeer}"

if [ $# -lt 1 ]; then
    echo "usage: tokeer verify <APPID>       # Steam: check setup, print a code to paste in the ticket"
    echo "       tokeer verify-ubi <APPID>   # Ubisoft: check the game files for the Proton flow"
    echo "       tokeer <CODE>               # activate + launch"
    echo "       tokeer <CODE> --no-launch   # write the ticket only"
    echo "       tokeer resign [APPID]       # re-sign the save if it won't load (no code needed)"
    echo "       tokeer lock <APPID>         # force the supported build of a version-locked game"
    echo "       tokeer ea-verify <APPID>    # EA: check files, patch anadius64, print ticket code"
    echo "       tokeer ea-request <APPID>   # EA: print the token_req to paste in the ticket"
    echo "       tokeer ea-apply <APPID> <dbdata.json|@file>  # EA: drop in dbdata.json + launch"
    exit 1
fi

# EA (anadius folder flow) subcommands -> ea_tokeer_linux.py. EA games don't use
# the native hook or the code system; the token comes from the ticket and lands
# in dbdata.json, so this is its own small tool.
case "$1" in
    ea-setup|ea-request|ea-apply|ea-verify)
        sub="${1#ea-}"; shift
        if [ ! -f "$TDIR/ea_tokeer_linux.py" ]; then
            echo "ERROR: EA tool missing from this bundle. Re-run install_linux.sh." >&2
            exit 1
        fi
        exec python3 "$TDIR/ea_tokeer_linux.py" "$sub" "$@"
        ;;
esac

# `tokeer lock <APPID>` -> write the version lock for a game whose newest Steam
# build breaks activation, then tell the user to run Steam's "update" (which the
# pin turns into the downgrade). verify runs this on its own too.
if [ "$1" = "lock" ]; then
    shift
    if [ ! -f "$TDIR/tokeer_version_lock.py" ]; then
        echo "ERROR: version lock tool missing. Re-run install_linux.sh <APPID>." >&2
        exit 1
    fi
    exec python3 "$TDIR/tokeer_version_lock.py" "$@"
fi

# `tokeer verify <APPID>` (Steam) / `tokeer verify-ubi <APPID>` (Ubisoft) ->
# run the setup validator and print the TLX1. code. verify-ubi passes the
# "ubisoft" mode so the validator checks files without the hook/launch option.
if [ "$1" = "verify" ] || [ "$1" = "verify-ubi" ]; then
    sub="$1"; shift
    if [ ! -f "$TDIR/tokeer_validate_linux.py" ]; then
        echo "ERROR: validator missing. Re-run install_linux.sh <APPID>." >&2
        exit 1
    fi
    if [ "$sub" = "verify-ubi" ]; then
        exec python3 "$TDIR/tokeer_validate_linux.py" "$@" ubisoft
    fi
    exec python3 "$TDIR/tokeer_validate_linux.py" "$@"
fi

if [ ! -f "$TDIR/tokeer_redeem_linux.py" ]; then
    echo "ERROR: Tokeer isn't installed. Run install_linux.sh <APPID> first." >&2
    exit 1
fi

exec python3 "$TDIR/tokeer_redeem_linux.py" "$@"
